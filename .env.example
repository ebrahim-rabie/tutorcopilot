# === LLM (OpenAI-compatible). Leave key empty to run retrieval-only modes ===
TC_LLM_API_KEY=
# TC_LLM_BASE_URL=https://api.openai.com/v1
# For Ollama: TC_LLM_BASE_URL=http://localhost:11434/v1  and TC_LLM_MODEL=llama3.1:8b
TC_LLM_MODEL=gpt-4o-mini
# TC_LLM_JUDGE_MODEL=
# Max output tokens. Reasoning models (gpt-oss) burn 500-1500 tokens thinking;
# too low a cap truncates content to "" and the API rejects with json_validate_failed.
# TC_MAX_TOKENS=4000

# === Embeddings: "local" (sentence-transformers) or "api" (OpenAI-compatible) ===
TC_EMBEDDING_MODE=local
TC_EMBEDDING_MODEL=all-MiniLM-L6-v2
# TC_EMBEDDING_API_MODEL=text-embedding-3-small

# === Rerank ===
TC_USE_RERANK=true
TC_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# === Chunking: markdown | recursive | semantic ===
TC_CHUNK_STRATEGY=markdown
TC_CHUNK_SIZE=500
TC_CHUNK_OVERLAP=80

# === Retrieval ===
TC_HYBRID_TOP_K=12
TC_FINAL_TOP_K=4
TC_RRF_K=60

# === Voice: STT (Groq Whisper, metered in audio seconds/day) + TTS (edge-tts, free) ===
# TC_STT_MODEL=whisper-large-v3-turbo
# TC_STT_MAX_UPLOAD_MB=10
# TC_TTS_PROVIDER=edge
# TC_TTS_VOICE=en-US-AriaNeural